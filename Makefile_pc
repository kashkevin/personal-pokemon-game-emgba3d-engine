# Native PC build of this pokeemerald-expansion fork: a standalone executable
# with no GBA emulator. The GBA ROM build (Makefile) stays the reference/fallback.
#
# Adapted from the pokeemerald PC port lineage (Kurausukun/pokeemerald pc_port ->
# gradenGnostic/pokeemerald-multiplatform -> ZallaxDev/pokeemerald-voxel-project).
# See src/platform/README.md for provenance and licensing.
#
# Prerequisite: the GBA build's generated sources and assets. Run `make` (or at
# least `make generated` plus the asset rules) once before this makefile.
#
#   make -f Makefile_pc                 # Windows 32-bit .exe (i686-w64-mingw32)
#   make -f Makefile_pc NATIVE_LINUX=1  # Linux i386 binary (development/testing)
#
# The game data holds 32-bit pointers, so both targets are 32-bit.

NATIVE_LINUX ?= 0
DEBUG        ?= 0
# SANITIZE=1 (Linux only): UBSan on game code to find GBA-only behaviour
# (shifts by 32+, NULL dereferences, out-of-bounds indexes). Development only.
# SANITIZE=address (Linux only): AddressSanitizer on game and renderer code to
# find out-of-range reads and writes the GBA tolerates (global/stack overflows).
# Soft reset is disabled in that build (it copies whole sections, redzones and all).
SANITIZE     ?= 0
# DIORAMA=1: build with the Diorama 3D overworld renderer (OpenGL 3.3; from
# ZallaxDev/pokeemerald-voxel-project, see src/diorama/README.md). Its rule tables
# are generated from this tree's maps and tilesets by tools/diorama_rules.
DIORAMA      ?= 0
# NATIVE_UI=1 (with DIORAMA=1): the native PC interface (src/native_ui/README.md)
# draws the approved UI design at the window's resolution in place of the GBA
# menus. NATIVE_UI=0 builds the 3D game without it (the GBA menus as before).
NATIVE_UI    ?= 1
DIORAMA_GENERATED_C := src/data/diorama/diorama_rules.generated.c src/data/diorama/tree_model.generated.c \
                       src/data/diorama/buildings.generated.c src/data/diorama/trees_3ds.generated.c
# BATTLE_SPRITES=1 (default): the Pokemon in battles are drawn from the animated sprite pack
# (battle-sprites.ebsp beside the program; include/platform/battle_sprites.h). Without the pack,
# with PKMN_BATTLE_SPRITES=0 or with BATTLE_SPRITES=0, the GBA sprites are drawn as ever.
BATTLE_SPRITES ?= 1

# GBA PPU emulation used for the 2D frame. The shipping Windows build uses the
# "easy draw" renderer; Linux uses it too so tests exercise what ships ("fast
# draw" has no 256-colour text backgrounds, see KNOWN_ISSUES N4).
TILE_RENDERER ?= RENDERER_EASY_DRAW

ifeq ($(NATIVE_LINUX),1)
  PREFIX        :=
  ifeq ($(SANITIZE),1)
    TARGET      := pokeemerald-mp-san
    OBJ_DIR     := build/pc-linux-san
  else ifeq ($(SANITIZE),address)
    TARGET      := pokeemerald-mp-asan
    OBJ_DIR     := build/pc-linux-asan
  else
    TARGET      := pokeemerald-mp
    OBJ_DIR     := build/pc-linux
  endif
else
  PREFIX        := i686-w64-mingw32-
  TARGET        := pokeemerald-mp.exe
  OBJ_DIR       := build/pc-win32
endif
ifeq ($(DIORAMA),1)
  TARGET        := $(basename $(TARGET))-diorama$(suffix $(TARGET))
  OBJ_DIR       := $(OBJ_DIR)-diorama
endif
# BFX_TEST=1 (with DIORAMA=1): the Battle FX and battle-environment test drivers (src/diorama/battlefx/bfx_test.c,
# src/diorama/scene/battle_env_test.c; tools/battlefx/gallery.sh). A test build, never shipped:
# pokeemerald-mp-diorama-bfxtest, objects in build/pc-linux-diorama-bfxtest.
BFX_TEST      ?= 0
ifeq ($(BFX_TEST),1)
  TARGET        := $(basename $(TARGET))-bfxtest$(suffix $(TARGET))
  OBJ_DIR       := $(OBJ_DIR)-bfxtest
endif
ifneq ($(NATIVE_LINUX),1)
  # SDL2 for i686-w64-mingw32 (headers in $(SDL_DIR)/include, libs in $(SDL_DIR)/lib)
  SDL_DIR       ?= /usr/i686-w64-mingw32
endif

CC      := $(PREFIX)gcc
AS      := $(PREFIX)as
OBJCOPY := $(PREFIX)objcopy
# Data files only need a C preprocessor; the host one is fine for both targets.
DATA_CPP := cpp

SHELL := bash -o pipefail

PREPROC    := tools/preproc/preproc
ASSETS_DIR := build/assets
ASM_TO_X86 := sed -E -f tools/pc_port/asm_to_x86.sed
ifneq ($(NATIVE_LINUX),1)
  # PE/COFF names read-only data .rdata; an input ".rodata" section would be
  # linked into a writable output section of its own.
  ASM_TO_X86 += -e 's/^([[:space:]]*)\.section[[:space:]]+\.rodata[[:space:]]*$$/\1.section .rdata,"dr"/'
endif

# Same game configuration as the GBA build (see Makefile), plus the PC port switches.
GAME_CPPFLAGS := -iquote include -Wno-trigraphs -DMODERN=1 -DTESTING=0 -DEMERALD -std=gnu17 \
                 -DMP_LOCAL_RESET_DEVELOPMENT=0 -DMP_LOCAL_RESET_STATIC=1 -DMP_LOCAL_RESET_NEW_MAUVILLE_PILOT=0
CPPFLAGS := $(GAME_CPPFLAGS) -DPORTABLE -DNONMATCHING -DUBFIX -DPLATFORM_SDL2 -D$(TILE_RENDERER) \
            -DSDL_DISABLE_IMMINTRIN_H -DSDL_DISABLE_MMINTRIN_H -DSDL_DISABLE_XMMINTRIN_H \
            -DSDL_DISABLE_EMMINTRIN_H -DSDL_DISABLE_PMMINTRIN_H

ifeq ($(NATIVE_LINUX),1)
  PKG_CONFIG_32 := PKG_CONFIG_LIBDIR=/usr/lib/i386-linux-gnu/pkgconfig:/usr/share/pkgconfig pkg-config
  CPPFLAGS += -m32 -DNATIVE_LINUX $(shell $(PKG_CONFIG_32) --cflags sdl2)
  LIBS     := $(shell $(PKG_CONFIG_32) --libs sdl2) -lm -lpthread
  ifeq ($(DIORAMA),1)
    LIBS   += -lGL
  endif
else
  CPPFLAGS += -I$(SDL_DIR)/include -isystem tools/pc_port/include-win32
  LIBS     := -L$(SDL_DIR)/lib -lmingw32 -lSDL2main -lSDL2 -lwinmm -lws2_32 -static-libgcc
  ifeq ($(DIORAMA),1)
    LIBS   += -lopengl32
  endif
endif
ifeq ($(DIORAMA),1)
  CPPFLAGS += -DENABLE_DIORAMA
  ifeq ($(BFX_TEST),1)
    CPPFLAGS += -DBATTLEFX_TEST -DDIORAMA_BATTLE_ENV_TEST
  endif
  ifeq ($(NATIVE_UI),1)
    CPPFLAGS += -DENABLE_NATIVE_UI
  endif
endif
ifeq ($(BATTLE_SPRITES),1)
  CPPFLAGS += -DENABLE_BATTLE_SPRITES
endif

ifeq ($(DEBUG),1)
  OPT := -O0 -g
else
  OPT := -O2 -g
endif

# -fno-strict-aliasing/-fwrapv: the game relies on type punning and wrapping
# integer arithmetic that the GBA compiler happened to tolerate.
# -falign-functions=4: function addresses keep bit 0 free for script tags.
# -fno-omit-frame-pointer: usable stack traces in crash.log (src/platform/crash_report.c).
CFLAGS := -m32 $(OPT) -std=gnu17 -fno-strict-aliasing -fwrapv -falign-functions=4 -fno-omit-frame-pointer \
          -Wno-trigraphs -Wno-pointer-to-int-cast -Wno-int-to-pointer-cast -Wno-attribute-alias \
          -Wno-unused-function -Wno-unused-variable -Wno-address-of-packed-member
ifeq ($(NATIVE_LINUX),1)
  CFLAGS += -fno-pie
  LDFLAGS := -m32 -no-pie -Wl,-z,noexecstack
  ifeq ($(SANITIZE),1)
    SAN_FLAGS := -fsanitize=shift-exponent,integer-divide-by-zero,null,bounds,vla-bound,unreachable,return \
                 -fsanitize-recover=all -fno-omit-frame-pointer
    CPPFLAGS  += -DNATIVE_SANITIZE
    LDFLAGS += -fsanitize=shift-exponent,integer-divide-by-zero,null,bounds,vla-bound,unreachable,return
  else ifeq ($(SANITIZE),address)
    SAN_FLAGS := -fsanitize=address -fsanitize-recover=address -fno-omit-frame-pointer
    CPPFLAGS  += -DNATIVE_ASAN
    LDFLAGS += -fsanitize=address
    # Platform code instrumented too (renderer, DMA, BIOS, audio), except the
    # tools that deliberately touch raw memory or install fault handlers.
    SAN_SKIP := game_memory.c null_trap.c fault_compat.c crash_report.c
  endif
else
  # Struct layout must match the GBA build (save data, mailboxes, asm-built data):
  # MinGW defaults to the MSVC layout (bit-fields of different types are not
  # packed together; 8-byte members are 8-aligned). These flags select the i386
  # System V layout that tools/pc_port/abi_layout.py verifies. Platform code must
  # therefore not exchange structs with bit-fields or 64-bit members with Windows
  # or SDL (none of the SDL events and Win32 structs used today have them).
  CFLAGS  += -mno-ms-bitfields -mno-align-double
  # Large address aware: on 64-bit Windows the 32-bit exe may address 4 GB, not 2
  # (the renderer's caches and the graphics driver's mappings live there; the
  # game's own memory is static and low). Tested under Wine with
  # PKMN_HIGH_ADDRESS_TEST=1 (platform/memory_info.h), which reserves the free
  # address space below 2 GB so everything a run allocates afterwards lies above
  # it: boot, Continue, the 3D field and the benchmark ran (2026-10-11). The
  # 32-bit Linux build has run with addresses above 2 GB all along.
  LDFLAGS := -m32 -mconsole -Wl,--large-address-aware
endif

# Objects whose globals survive a soft reset (window, audio device, cartridge
# save image and clock, platform tools). Every other object's .data/.bss is moved
# into the game sections that src/platform/game_memory.c snapshots and restores.
PRESERVED_OBJS := $(addprefix $(OBJ_DIR)/src/platform/,sdl2.o agb_flash_pc.o siirtc_pc.o game_memory.o null_trap.o fault_compat.o crash_report.o mp_bridge.o frame_limiter.o memory_info.o)
ifeq ($(DIORAMA),1)
  # The renderer (GL objects, snapshot exchange, caches) is platform state: it
  # keeps its memory across a soft reset like the window does.
  PRESERVED_OBJS += $(patsubst src/%.c,$(OBJ_DIR)/src/%.o,$(wildcard src/diorama/*.c src/diorama/*/*.c) $(DIORAMA_GENERATED_C))
  # Battle FX (include/diorama/battle_fx.h): the HD move and battle animations
  # over the 3D battle. Its JavaScript engine, QuickJS-ng (third_party/quickjs-ng,
  # MIT), is platform state like the renderer and is built with flags of its own:
  # no game preprocessing, and SSE2 doubles, so these 32-bit builds compute the
  # animation core's numbers exactly as the 64-bit builds it was verified with
  # (x87's extended precision would not; tools/battlefx/build_check.sh).
  # stb_image (third_party/stb, public domain) reads its PNG textures, built the same way.
  BFX_QJS_DIR    := third_party/quickjs-ng
  BFX_QJS_OBJS   := $(patsubst %,$(OBJ_DIR)/$(BFX_QJS_DIR)/%.o,cutils libregexp libunicode quickjs xsum) \
                    $(OBJ_DIR)/third_party/stb/bfx_stb_image.o
  PRESERVED_OBJS += $(BFX_QJS_OBJS)
  CPPFLAGS       += -I$(BFX_QJS_DIR) -Ithird_party/stb
  BFX_QJS_CFLAGS  = -m32 $(OPT) -msse2 -mfpmath=sse -w -D_GNU_SOURCE
  ifeq ($(NATIVE_LINUX),1)
    BFX_QJS_CFLAGS += -fno-pie
  else
    BFX_QJS_CFLAGS += -mno-ms-bitfields -mno-align-double -DWIN32_LEAN_AND_MEAN -D_WIN32_WINNT=0x0601
  endif
  ifeq ($(NATIVE_UI),1)
    # The native UI (atlas, caches, GL objects) is platform state too.
    PRESERVED_OBJS += $(patsubst src/%.c,$(OBJ_DIR)/src/%.o,$(wildcard src/native_ui/*.c src/native_ui/*/*.c))
  endif
endif
ifeq ($(BATTLE_SPRITES),1)
  # The loaded sprite pack and its decoded frames are platform state, kept across a soft reset.
  PRESERVED_OBJS += $(addprefix $(OBJ_DIR)/src/platform/,battle_sprites.o battle_sprite_library.o)
endif

ASFLAGS := --defsym MODERN=1 --defsym EMERALD=1 --defsym PORTABLE=1
ifeq ($(NATIVE_LINUX),1)
  ASFLAGS += --32
  FIX_UNDERSCORE := true
  GAME_SECTIONS := --rename-section .data=game_data --rename-section .bss=game_bss
else
  # 32-bit Windows C symbols carry a leading underscore; asm data symbols do not.
  FIX_UNDERSCORE := $(OBJCOPY) --prefix-symbol _
  GAME_SECTIONS := --rename-section .data=.data\$$game --rename-section .bss=.bss\$$game
endif
MARK_GAME_MEMORY = $(if $(filter $@,$(PRESERVED_OBJS)),true,$(OBJCOPY) $(GAME_SECTIONS) $@)
# Rebuild every object when the compiler flags or the section layout change
# (make does not track flags, and objects are marked when they are built).
# BUILD_CONFIG_ID is completed below, once all flags are known.
BUILD_CONFIG_STAMP := $(OBJ_DIR)/build_config.stamp

# Sanitizer flags for the object being built: UBSan covers game code only;
# AddressSanitizer covers game and platform code except SAN_SKIP.
ifeq ($(SANITIZE),address)
  SAN_FLAGS_FOR = $(if $(filter $(SAN_SKIP),$(notdir $<)),,$(SAN_FLAGS))
else
  SAN_FLAGS_FOR = $(if $(findstring src/platform/,$<),,$(SAN_FLAGS))
endif

BUILD_CONFIG_ID := $(CC) $(CPPFLAGS) | $(CFLAGS) | $(SAN_FLAGS) | $(ASFLAGS) | $(ASM_TO_X86) | $(GAME_SECTIONS) | $(PRESERVED_OBJS) | $(BFX_QJS_CFLAGS)
ifneq ($(file <$(BUILD_CONFIG_STAMP)),$(BUILD_CONFIG_ID))
  $(shell mkdir -p $(OBJ_DIR))
  $(file >$(BUILD_CONFIG_STAMP),$(BUILD_CONFIG_ID))
endif

# ---------------------------------------------------------------------------
# Sources
# GBA-only C files replaced or made unnecessary by the platform layer.
PC_EXCLUDED_C := src/m4a.c src/m4a_tables.c src/rom_header_gf.c src/rom_header_rhh.c \
                 src/agb_flash.c src/agb_flash_1m.c src/agb_flash_mx.c src/agb_flash_le.c \
                 src/siirtc.c
ifneq ($(BATTLE_SPRITES),1)
  PC_EXCLUDED_C += src/platform/battle_sprites.c src/platform/battle_sprite_library.c
endif
C_SRCS_IN := $(wildcard src/*.c src/*/*.c src/*/*/*.c)
# The Diorama renderer and its generated tables only in DIORAMA=1 builds.
ifeq ($(DIORAMA),1)
  C_SRCS_IN := $(sort $(C_SRCS_IN) $(DIORAMA_GENERATED_C))
else
  PC_EXCLUDED_C += $(filter src/diorama/% src/data/diorama/%,$(C_SRCS_IN))
endif
# The native UI only in DIORAMA=1 NATIVE_UI=1 builds.
ifneq ($(DIORAMA)$(NATIVE_UI),11)
  PC_EXCLUDED_C += $(filter src/native_ui/%,$(C_SRCS_IN))
endif
C_SRCS    := $(filter-out $(PC_EXCLUDED_C),$(foreach src,$(C_SRCS_IN),$(if $(findstring .inc.c,$(src)),,$(src))))
C_OBJS    := $(patsubst src/%.c,$(OBJ_DIR)/src/%.o,$(C_SRCS))

DATA_ASM_SRCS := $(wildcard data/*.s)
DATA_ASM_OBJS := $(patsubst data/%.s,$(OBJ_DIR)/data/%.o,$(DATA_ASM_SRCS))

MID_SRCS := $(wildcard sound/songs/midi/*.s)
MID_OBJS := $(patsubst sound/songs/midi/%.s,$(OBJ_DIR)/sound/songs/midi/%.o,$(MID_SRCS))

OBJS := $(C_OBJS) $(DATA_ASM_OBJS) $(MID_OBJS) $(BFX_QJS_OBJS)

$(shell mkdir -p $(sort $(dir $(OBJS))))

.PHONY: all clean check-native check-abi check-game-sections check-decompress check-party-order check-battle-names check-cry-stop check-shake-anim check-line-break check-wild-weather check-legend check-shiny check-coins check-species-data check-clock check-mp-objects check-spawn-claims check-secret-base check-rewards check-catch-reconcile check-pokenav-map check-ladder check-coop-exp check-coop-controller check-keybinds check-graphics-mode
.SUFFIXES:
.SECONDARY:
.DELETE_ON_ERROR:

all: $(TARGET)

clean:
	rm -rf $(OBJ_DIR) $(TARGET)

# Native unit tests for project-owned platform code (Linux, 32-bit).
NATIVE_TEST_DIR := build/pc-tests
NATIVE_TEST_SDL := PKG_CONFIG_LIBDIR=/usr/lib/i386-linux-gnu/pkgconfig:/usr/share/pkgconfig pkg-config
NATIVE_TEST_SRCS := tools/pc_port/tests/test_platform.c src/platform/agb_flash_pc.c src/platform/siirtc_pc.c \
                    src/platform/gba_support.c src/platform/fault_compat.c src/platform/dma.c src/random.c
check-native:
	@mkdir -p $(NATIVE_TEST_DIR)
	@for f in $(NATIVE_TEST_SRCS); do \
	  o=$(NATIVE_TEST_DIR)/$$(basename $$f .c).o; \
	  gcc -m32 -E $(GAME_CPPFLAGS) -DPORTABLE -DNONMATCHING -DUBFIX -DNATIVE_LINUX -iquote tools/pc_port/tests $$f \
	    | $(PREPROC) -i -p $$f charmap.txt | gcc -m32 -O1 -g -fno-pie -fwrapv -x cpp-output -c -o $$o - || exit 1; \
	done
	@gcc -m32 -no-pie $(NATIVE_TEST_DIR)/*.o -o $(NATIVE_TEST_DIR)/test_platform
	@$(NATIVE_TEST_DIR)/test_platform
	@gcc -m32 -std=gnu99 -Wall -Wextra -Werror -O1 -g -DMP_BRIDGE_UNIT_TEST -iquote include -iquote tools/pc_port/tests \
	  tools/pc_port/tests/test_mp_bridge.c src/platform/mp_bridge.c -o $(NATIVE_TEST_DIR)/test_mp_bridge
	@$(NATIVE_TEST_DIR)/test_mp_bridge
	@gcc -m32 -std=gnu99 -Wall -Wextra -Werror -O1 -g -iquote include -iquote tools/pc_port/tests \
	  $$($(NATIVE_TEST_SDL) --cflags sdl2) -DFRAME_LIMITER_UNIT_TEST tools/pc_port/tests/test_display_settings.c src/platform/display_settings.c \
	  src/platform/pc_menu.c src/platform/keybinds.c src/platform/benchmark.c src/platform/frame_limiter.c \
	  -o $(NATIVE_TEST_DIR)/test_display_settings
	@$(NATIVE_TEST_DIR)/test_display_settings
	@gcc -m32 -std=gnu99 -Wall -Wextra -Werror -O1 -g -iquote include -iquote tools/pc_port/tests \
	  $$($(NATIVE_TEST_SDL) --cflags sdl2) tools/pc_port/tests/test_keybinds.c src/platform/keybinds.c \
	  -o $(NATIVE_TEST_DIR)/test_keybinds
	@$(NATIVE_TEST_DIR)/test_keybinds
	@gcc -m32 -std=gnu99 -Wall -Wextra -Werror -O1 -g -iquote include -iquote tools/pc_port/tests \
	  tools/pc_port/tests/test_gamepad.c src/platform/gamepad.c -o $(NATIVE_TEST_DIR)/test_gamepad
	@$(NATIVE_TEST_DIR)/test_gamepad
	@gcc -m32 -std=gnu99 -Wall -Wextra -Werror -O1 -g -iquote include -iquote tools/pc_port/tests \
	  tools/pc_port/tests/test_key_queue.c src/platform/key_queue.c -o $(NATIVE_TEST_DIR)/test_key_queue
	@$(NATIVE_TEST_DIR)/test_key_queue
	@gcc -m32 -std=gnu99 -Wall -Wextra -Werror -O1 -g -iquote include -iquote tools/pc_port/tests \
	  $$($(NATIVE_TEST_SDL) --cflags sdl2) tools/pc_port/tests/test_png_write.c src/platform/png_write.c \
	  $$($(NATIVE_TEST_SDL) --libs sdl2) -o $(NATIVE_TEST_DIR)/test_png_write
	@rm -f $(NATIVE_TEST_DIR)/png-*.png
	@$(NATIVE_TEST_DIR)/test_png_write $(NATIVE_TEST_DIR)
	@python3 tools/pc_port/tests/check_png.py $(NATIVE_TEST_DIR)

# GBA vs native byte layout of save data, mailboxes, battle packets and asm-built data.
check-abi:
	python3 tools/pc_port/abi_layout.py

# Every compressed graphic decoded natively by the game's own decompressor must
# equal the uncompressed file the GBA build compressed it from.
check-decompress: $(TARGET)
	python3 tools/pc_port/make_decompress_list.py $(ASSETS_DIR) > $(OBJ_DIR)/decompress_list.txt
	./$(TARGET) --selftest-decompress $(OBJ_DIR)/decompress_list.txt | tail -n 20

# The battle's party order for single, double, two-opponent and Multi battles,
# run in the game itself (KNOWN_ISSUES N37: two opponent trainers wrote past an
# array as the battle started). Every case must return and keep the game's order.
check-party-order: $(TARGET)
	@./$(TARGET) --selftest-party-order > $(OBJ_DIR)/selftest-party-order.log 2>&1; status=$$?; \
	  tail -n 3 $(OBJ_DIR)/selftest-party-order.log; exit $$status

# Battle messages naming two trainers with their classes (KNOWN_ISSUES N38: the
# names went on past a 32-byte buffer as Mossdeep's Space Center Multi battle
# began), for every trainer against the longest-named one. Each must return and
# read as each name alone does.
check-battle-names: $(TARGET)
	@./$(TARGET) --selftest-battle-names > $(OBJ_DIR)/selftest-battle-names.log 2>&1; status=$$?; \
	  tail -n 3 $(OBJ_DIR)/selftest-battle-names.log; exit $$status

# The Pokemon cry functions before any cry has played (KNOWN_ISSUES N39: a double
# battle's send-out right after a save was continued stopped a cry that was not
# there, natively a segmentation fault). Each must return.
# The launcher's Graphics mode (3D Diorama / Classic 2D): --probe-graphics, a failed
# renderer start (exit 78 with an explanation, no save or settings written) and the
# Classic 2D game keeping the 3D view's settings. Run it on either game build.
check-graphics-mode: $(TARGET)
	@bash tools/pc_port/tests/check_graphics_mode.sh ./$(TARGET)

check-cry-stop: $(TARGET)
	@./$(TARGET) --selftest-cry-stop > $(OBJ_DIR)/selftest-cry-stop.log 2>&1; status=$$?; \
	  tail -n 3 $(OBJ_DIR)/selftest-cry-stop.log; exit $$status

# A move animation shaking a battler or the background (KNOWN_ISSUES N40: natively
# the address of what it shakes sign-extended where its bit 15 is set, a fault in
# Rock Slide's, Metal Claw's... animation). Each shake must end and restore its value.
check-shake-anim: $(TARGET)
	@./$(TARGET) --selftest-shake-anim > $(OBJ_DIR)/selftest-shake-anim.log 2>&1; status=$$?; \
	  tail -n 3 $(OBJ_DIR)/selftest-shake-anim.log; exit $$status

# Trainer defeat lines a little wider than the battle message box (KNOWN_ISSUES
# U13: natively a fault after Psychic Edward's battle on Route 110). The eight
# texts found, through the real BattleStringExpandPlaceholders, must come back whole.
check-line-break: $(TARGET)
	@./$(TARGET) --selftest-line-break > $(OBJ_DIR)/selftest-line-break.log 2>&1; status=$$?; \
	  tail -n 3 $(OBJ_DIR)/selftest-line-break.log; exit $$status

check-wild-weather: $(TARGET)
	@./$(TARGET) --selftest-wild-weather > $(OBJ_DIR)/selftest-wild-weather.log 2>&1; status=$$?; \
	  tail -n 3 $(OBJ_DIR)/selftest-wild-weather.log; exit $$status

# Update 29: random Legendary / Mythical encounters (60M-roll statistics, about 90 s), shiny odds (20M per case), the coin economy.
check-legend: $(TARGET)
	@./$(TARGET) --selftest-legend > $(OBJ_DIR)/selftest-legend.log 2>&1; status=$$?; \
	  tail -n 3 $(OBJ_DIR)/selftest-legend.log; exit $$status

check-shiny: $(TARGET)
	@./$(TARGET) --selftest-shiny > $(OBJ_DIR)/selftest-shiny.log 2>&1; status=$$?; \
	  tail -n 3 $(OBJ_DIR)/selftest-shiny.log; exit $$status

check-coins: $(TARGET)
	@./$(TARGET) --selftest-coins > $(OBJ_DIR)/selftest-coins.log 2>&1; status=$$?; \
	  tail -n 3 $(OBJ_DIR)/selftest-coins.log; exit $$status

# Species data, moves, abilities, trainers, wild level tables: fingerprints against the pre-update baseline.
check-species-data: $(TARGET)
	@python3 tools/pc_port/species_data_check.py --binary ./$(TARGET)

# The test pins its start to noon of the player's day, so it must pass at any wall-clock time of day:
# run it in four zones six hours apart (one of them is always within three hours of local midnight).
check-clock: $(TARGET)
	@status=0; for tz in UTC-0 UTC-6 UTC-12 UTC+6; do \
	  TZ=$$tz ./$(TARGET) --selftest-clock > $(OBJ_DIR)/selftest-clock.log 2>&1 || { status=1; echo "check-clock failed with TZ=$$tz"; }; \
	  tail -n 1 $(OBJ_DIR)/selftest-clock.log; done; exit $$status

check-keybinds: $(TARGET)
	@./$(TARGET) --selftest-keybinds > $(OBJ_DIR)/selftest-keybinds.log 2>&1; status=$$?; \
	  tail -n 3 $(OBJ_DIR)/selftest-keybinds.log; exit $$status

